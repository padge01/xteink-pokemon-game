---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const installUrl = `${baseUrl}install.html`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${installUrl}`} />
    <title>Pokémon for Xteink X3</title>
  </head>
  <body>
    <p><a href={installUrl}>Open the Xteink X3 installer</a></p>
  </body>
</html>
